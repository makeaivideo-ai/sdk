{
  "name": "@makeaivideo/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript/JavaScript SDK for MakeAIVideo, the AI video generator API: turn a prompt or script into a finished video (voiceover, AI or stock scenes, captions, music) and post it to TikTok, Instagram Reels, YouTube Shorts and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "makeaivideo",
    "ai-video",
    "ai-video-generator",
    "ai video api",
    "text-to-video",
    "script-to-video",
    "video-generation",
    "video-api",
    "sdk",
    "typescript",
    "javascript",
    "nodejs",
    "tiktok",
    "instagram-reels",
    "youtube-shorts",
    "short-form-video",
    "faceless-video",
    "ai-voiceover",
    "social-media-automation",
    "auto-post",
    "generative-ai",
    "rest-api"
  ],
  "author": "MakeAIVideo <support@makeaivideo.ai> (https://makeaivideo.ai)",
  "license": "MIT",
  "homepage": "https://makeaivideo.ai/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makeaivideo-ai/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/makeaivideo-ai/sdk/issues",
    "email": "support@makeaivideo.ai"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
